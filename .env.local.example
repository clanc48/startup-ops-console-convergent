# Archived portfolio sample: use a Supabase project you control.
# Never reuse credentials from a historical deployment.

# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --------------------------------------------------------------------------------------
# SERVER ONLY - do not expose these in browser code or commit real values.
# --------------------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional AI executive summaries. Leave blank to keep AI disabled/unavailable.
OPENAI_API_KEY=

# Required if the demo worker endpoint is ever exposed with NODE_ENV=production.
WORKER_TOKEN=

# Optional feature gate. Core simulation does not require AI.
ENABLE_AI=false

# Extra server diagnostics. Keep disabled unless actively troubleshooting.
# Debug logging is written to avoid token/cookie values, but production defaults should stay quiet.
DEBUG_SERVER=0
